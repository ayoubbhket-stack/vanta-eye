# ── Database ───────────────────────────────────────────────
# Production: a PostgreSQL connection string (Neon, Supabase, RDS, Railway…)
#   DATABASE_URL=postgres://user:password@host:5432/vanta?sslmode=require
# Local development: leave empty to use the embedded Postgres (PGlite) in ./data/pglite
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Public URL of the site (used for payment callbacks, sitemap, reset links)
SITE_URL=http://localhost:3000

# One-time token that unlocks /admin/setup to create the first owner account.
# Setup is disabled automatically once any admin exists. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SETUP_TOKEN=

# ── Online payments: Paymob (optional) ─────────────────────
# Online payment appears at checkout only when ALL four values are set.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
# PAYMOB_BASE_URL=https://accept.paymob.com

# ── Email notifications: Resend (optional) ─────────────────
RESEND_API_KEY=
MAIL_FROM="VANTA EYE <orders@yourdomain.com>"
